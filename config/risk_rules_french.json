    {
      "id": "default_level_4",
      "description": "Pas de facteurs de risque identifiés - évaluation standard",
      "description_en": "No risk factors identified - standard evaluation",
      "level": "4",
      "band": "green",
      "priority": -50,
      "conditions": []
    }
  ]
